function validate(formId, body) {
  const def = FORMS[formId];
  if (!def) return { status: 404, error: "Unknown form." };
  // Spam: honeypot + minimum fill time (3 s) — silent success for bots.
  if (body.website) return { status: 200, spam: true };
  const ts = Number(body._ts);
  if (!ts || Date.now() - ts < 3000) return { status: 200, spam: true };

  const clean = {}, fields = {};
  const today = new Date().toISOString().slice(0, 10);
  for (const fd of def.fields) {
    let v = body[fd.name];
    if (fd.multi) {
      v = [].concat(v ?? []).map(String).filter(Boolean);
      if (v.some((x) => !fd.multi.includes(x))) fields[fd.name] = "Please choose from the list.";
      if (fd.required && !v.length) fields[fd.name] = "Please choose at least one.";
      clean[fd.name] = v; continue;
    }
    v = typeof v === "string" ? v.trim() : v == null ? "" : String(v);
    if (!v) { if (fd.required) fields[fd.name] = "This field is required."; continue; }
    if (v.length > fd.max) fields[fd.name] = `Please keep this under ${fd.max} characters.`;
    else if (fd.enum && !fd.enum.includes(v)) fields[fd.name] = "Please choose from the list.";
    else if (fd.pattern && !fd.pattern.test(v)) fields[fd.name] = "Please check the format.";
    else if (fd.notFuture && v > today) fields[fd.name] = "This date cannot be in the future.";
    else if (fd.future && v <= today) fields[fd.name] = "Please choose a date from tomorrow onwards.";
    clean[fd.name] = v;
  }
  if (Object.keys(fields).length) return { status: 422, error: "Please check the highlighted fields.", fields };
  return { status: 200, data: clean, def };
}
// ─────────────────────────────────────────────────────────────────────────────────────────────────

const META_COLUMNS = ['reference', 'received_at', 'status', 'respond_by', 'expires_at'];

function setup() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  Object.keys(FORMS).forEach(function (id) { sheetFor_(ss, id); });
  ScriptApp.getProjectTriggers().forEach(function (t) { if (t.getHandlerFunction() === 'purge') ScriptApp.deleteTrigger(t); });
  ScriptApp.newTrigger('purge').timeBased().everyDays(1).atHour(3).create();
  const first = ss.getSheetByName('Sheet1');
  if (first && ss.getSheets().length > 1 && first.getLastRow() === 0) ss.deleteSheet(first);
  return 'Ready: ' + Object.keys(FORMS).length + ' form tabs, daily clean-up at 3 am.';
}

function columnsFor_(id) {
  const fields = FORMS[id].fields.map(function (fd) { return fd.name; });
  return id === 'condolence' ? ['reference', 'received_at', 'status'].concat(fields) : META_COLUMNS.concat(fields);
}

function sheetFor_(ss, id) {
  let sh = ss.getSheetByName(id);
  if (!sh) {
    sh = ss.insertSheet(id);
    const cols = columnsFor_(id);
    // Plain-text columns: stops Sheets turning phone numbers into numbers (losing the leading 0) or dates into Date objects.
    sh.getRange(1, 1, sh.getMaxRows(), cols.length).setNumberFormat('@');
    sh.getRange(1, 1, 1, cols.length).setValues([cols]).setFontWeight('bold');
    sh.setFrozenRows(1);
  }
  return sh;
}

function iso_(v) { return v instanceof Date ? v.toISOString() : String(v == null ? '' : v); }

function json_(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}

// A cell that starts with = + - @ would run as a spreadsheet formula. Prefix it so it stays text.
function cell_(v) {
  let s = Array.isArray(v) ? v.join('; ') : (v == null ? '' : String(v));
  if (/^[=+\-@\t\r]/.test(s)) s = "'" + s;
  return s;
}

function doPost(e) {
  let body;
  try { body = JSON.parse(e.postData.contents); } catch (err) { return json_({ error: 'We could not read that form.' }); }
  if (!body || typeof body !== 'object' || Array.isArray(body)) return json_({ error: 'We could not read that form.' });
  const id = String(body.form || '');

  // Apps Script cannot see visitors' IP addresses, so limit the total rate instead (stops floods).
  const cache = CacheService.getScriptCache();
  const bucket = 'rate-' + Math.floor(Date.now() / 600000);
  const count = Number(cache.get(bucket) || 0) + 1;
  cache.put(bucket, String(count), 900);
  if (count > 120) return json_({ error: 'We are receiving a lot of messages right now. Please call us.' });

  const r = validate(id, body);
  if (r.status !== 200) return json_({ error: r.error, fields: r.fields });
  if (r.spam) return json_({ message: 'Thank you.' });

  const now = new Date();
  const reference = Utilities.getUuid().slice(0, 8).toUpperCase();
  const def = r.def;
  const lock = LockService.getScriptLock();
  lock.waitLock(10000);
  try {
    const sh = sheetFor_(SpreadsheetApp.getActiveSpreadsheet(), id);
    const values = id === 'condolence'
      ? [reference, now.toISOString(), 'pending']
      : [reference, now.toISOString(), 'new',
         new Date(now.getTime() + def.slaHours * 3600000).toISOString(),
         def.retentionDays ? new Date(now.getTime() + def.retentionDays * 86400000).toISOString() : ''];
    def.fields.forEach(function (fd) { values.push(cell_(r.data[fd.name])); });
    sh.appendRow(values);
  } finally { lock.releaseLock(); }

  if (id !== 'condolence' && ALERT_EMAIL) {
    try { sendAlert_(id, def, r.data, reference); } catch (err) { console.error('Alert failed: ' + err); }
  }
  return json_({ ok: true, message: def.message, reference: reference });
}

function doGet(e) {
  const p = (e && e.parameter) || {};
  if (p.action !== 'condolences') return json_({ ok: true });
  const notice = String(p.notice || '').slice(0, 120);
  const sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('condolence');
  if (!notice || !sh || sh.getLastRow() < 2) return json_([]);
  const rows = sh.getDataRange().getValues();
  const head = rows.shift();
  const col = function (n) { return head.indexOf(n); };
  const out = rows
    .filter(function (r) { return String(r[col('status')]).trim().toLowerCase() === 'approved' && r[col('notice')] === notice; })
    .slice(-500)
    .map(function (r) {   // published fields only: never the email address
      return { name: String(r[col('name')]), town: String(r[col('town')] || ''), message: String(r[col('message')]),
               date: iso_(r[col('received_at')]).slice(0, 10) };
    });
  return json_(out);
}

function sendAlert_(id, def, data, reference) {
  const pick = function (keys) { for (let i = 0; i < keys.length; i++) if (data[keys[i]]) return String(data[keys[i]]); return ''; };
  const clean = function (s) { return String(s == null ? '' : s).replace(/[\r\n]+/g, ' ').slice(0, 200); };
  const urgent = def.slaHours <= 0.5;
  const within = def.slaHours < 1 ? Math.round(def.slaHours * 60) + ' minutes' : def.slaHours + ' hours';
  const lines = [
    def.title + (urgent ? '  (URGENT)' : ''),
    'Reference: ' + reference,
    'Respond within: ' + within + '  ·  Owner: ' + def.owner,
    '',
    'Name:  ' + clean(pick(['name', 'caller_name', 'submitter_name', 'first_name'])),
    'Phone: ' + clean(pick(['phone', 'caller_phone', 'submitter_phone'])),
    'Email: ' + clean(pick(['email', 'caller_email', 'submitter_email'])),
  ];
  if (id === 'first-notification') lines.push('Deceased: ' + clean(data.deceased_name), 'Place: ' + clean(data.place_type), 'Doctor: ' + clean(data.doctor_status));
  if (id === 'callback') lines.push('About: ' + clean(data.reason), 'Best time: ' + clean(data.best_time || 'asap'));
  if (id === 'appointment') lines.push('Date: ' + clean(data.date) + ' ' + clean(data.time_slot), 'Where: ' + clean(data.location));
  lines.push('', 'Full details: the "' + id + '" tab of ' + SpreadsheetApp.getActiveSpreadsheet().getUrl());
  MailApp.sendEmail({ to: ALERT_EMAIL, subject: (urgent ? '🔴 URGENT: ' : '') + def.title + ' – ref ' + reference,
                      body: lines.join('\n'), name: 'Website alerts' });
}

/** Daily (trigger from setup): delete rows past their retention date; tidy condolences. */
function purge() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const now = new Date().toISOString();
  const monthAgo = new Date(Date.now() - 30 * 86400000).toISOString();
  const yearAgo = new Date(Date.now() - 365 * 86400000).toISOString();
  Object.keys(FORMS).forEach(function (id) {
    const sh = ss.getSheetByName(id);
    if (!sh || sh.getLastRow() < 2) return;
    const rows = sh.getDataRange().getValues();
    const head = rows[0];
    for (let i = rows.length - 1; i >= 1; i--) {
      const r = rows[i];
      if (id === 'condolence') {
        const status = String(r[head.indexOf('status')]).toLowerCase();
        const at = iso_(r[head.indexOf('received_at')]);
        if (status === 'rejected' && at < monthAgo) { sh.deleteRow(i + 1); continue; }
        if (at < yearAgo && r[head.indexOf('email')]) sh.getRange(i + 1, head.indexOf('email') + 1).setValue('');
      } else {
        const exp = r[head.indexOf('expires_at')] ? iso_(r[head.indexOf('expires_at')]) : '';
        if (exp && exp < now) sh.deleteRow(i + 1);
      }
    }
  });
}

/** Run from the editor to check that alert emails arrive. */
function testAlert() {
  sendAlert_('callback', FORMS.callback, { name: 'Test Person', phone: '087 000 0000', reason: 'death' }, 'TEST1234');
}
