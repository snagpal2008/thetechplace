{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dilis-portal",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // Cloudflare D1 (serverless SQLite). The deploy workflow creates the database
  // if needed and fills in database_id automatically.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dilis-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "APP_URL": "",
    "PLATFORM_NAME": "Dílis"
  }
  // Secrets (`npx wrangler secret put NAME`): AUTH_SECRET (auto-created by the
  // deploy workflow), STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET (optional).
}
