{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dilis-portal",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // Hyperdrive pools connections to your Postgres (Neon / Supabase / RDS).
  // Create it with:  npx wrangler hyperdrive create dilis-db --connection-string="postgres://..."
  // then paste the returned id below.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "REPLACE_WITH_HYPERDRIVE_ID",
      "localConnectionString": "postgres://postgres:postgres@localhost:5432/dilis"
    }
  ],
  "vars": {
    "APP_URL": "https://dilis-portal.example.workers.dev",
    "PLATFORM_NAME": "Dílis"
  }
  // Secrets (set with `npx wrangler secret put NAME`):
  //   AUTH_SECRET, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET
}
